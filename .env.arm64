# ------------------------------
# 通用配置
# ------------------------------
PLATFORM=linux/arm64/v8
TIMEZONE=Asia/Shanghai
PRIVILEGED=true
RESTART_POLICY=always
LOGGING_DRIVER=json-file
LOG_MAX_SIZE=1m
NETWORK_TYPE=bridge

# ------------------------------
# S-Tip 配置
# ------------------------------
IMAGE_S_TIP=ghcr.io/yHUJibXnPx/docker-arch-s-tip:latest
CONTAINER_S_TIP=s_tip_container
BUILD_CONTEXT=.
START_SCRIPT=configure-cron.sh

# 自定义脚本目录（宿主机路径），会挂载到容器内 /scripts/
# 在 HOSTS_JSON 中用 "script_file": "/scripts/xxx.sh" 引用
CUSTOM_SCRIPTS_DIR=./custom_scripts

# ------------------------------
# 任务调度配置
# ------------------------------
CRON_SCHEDULE=0 */8 * * *

# ------------------------------
# 服务器信息（HOSTS_JSON）
#
# 每台主机支持以下字段：
#   host         必填  主机地址
#   username     必填  登录用户
#   port         必填  SSH 端口
#   password     必填  登录密码
#   script_file  可选  容器内脚本文件路径
#                      挂载方式：宿主机 CUSTOM_SCRIPTS_DIR → 容器 /scripts/
#   script       可选  JSON 内联单行脚本
# HOSTS_JSON 格式：
# {
#   "info": [
#     {
#       "host":        "server1.com",            必填，服务器 ip 或 domain
#       "username":    "root",                   必填，服务器登陆 用户名
#       "port":        22,                       必填，服务器 ssh 端口
#       "password":    "xxx",                    必填，服务器登陆 密码
#       "script":      "uname -a",               可选，自定义 `script` 单行命令与 `.env` 的 `SCRIPT` 变量等效
#       "script_file": "/scripts/system_info.sh" 可选，自定义脚本文件，指向容器内路径 `/scripts` 即可，默认对应宿主机映射路径 `./custom_scripts`
#     }
#   ]
# }
# 脚本执行顺序（全部并存，按序拼接，不填自动跳过）：
#   全局 SCRIPT → 主机 script → 主机 script_file(s)
#
# 推送控制完全由脚本输出决定：
#   有输出 → s-tip 推送
#   无输出 → s-tip 静默跳过
#   SSH 连接失败 → 始终推送
#
# 示例：
#   server1 → script_file=[check_singbox, system_info, check_disk]，三个脚本按顺序执行
#   server2 → script="echo hello" + script_file=check_disk.sh，两者拼接执行
#   server3 → 只用全局 SCRIPT 做常规巡检
# ------------------------------
# ------------------------------
# 服务器信息（明文与 Secret 二选一）
# ------------------------------
# 方式一：明文 JSON 字符串（不安全，适合测试）
#HOSTS_JSON={"info":[{"host":"server1.com","username":"root","port":22,"password":"123456","script_file":["/scripts/check_disk.sh","/scripts/system_info.sh"],"script":"uname -a"},{"host":"server2.com","username":"root","port":8022,"password":"123456","script_file":"/scripts/check_singbox.sh"},{"host":"server3.com","username":"root","port":22,"password":"123456"}]}
# 方式二：Docker Secret 文件（安全，推荐）
# 将内容保存到 ./secrets/hosts.json 文件中
HOSTS_JSON_FILE=/run/secrets/hosts.json

# ------------------------------
# 全局默认远程脚本
# ------------------------------
SCRIPT=echo '=== system ===' ; uname -a ; echo '=== disk ===' ; df -h ; echo '=== time ===' ; date ; echo '=== ps ===' ; ps

# ------------------------------
# 独立推送开关
# true 启用（默认），false 禁用
# ------------------------------
ENABLE_TG=true
ENABLE_EMAIL=true

# ------------------------------
# Telegram 配置（明文与 Secret 二选一）
# ------------------------------
# 方式一：明文
#TELEGRAM_TOKEN=21***5:XXXab****cDE5qs

# 方式二：文件
TELEGRAM_TOKEN_FILE=/run/secrets/tg_token.txt
TELEGRAM_USERID=123456789

# ------------------------------
# 邮件配置（明文与 Secret 二选一）
# ------------------------------
# 类型 password 或 oauth2
AUTHTYPE=password
MAILADDR=smtp.smtpserver.com
MAILPORT=25
MAILUSERNAME=469138946ba5fa
# 方式一：明文密码
#MAILPASSWORD=12345678900000
# 方式二：密码文件
MAILPASSWORD_FILE=/run/secrets/mail_pass.txt
MAILFROM=how@469138946ba5fa.what.why
MAILSENDTO=how@469138946ba5fa.what.why

# ------------------------------
# 代理配置（可选）
# ------------------------------
PROXY_HTTP=http://192.168.255.253:7890
PROXY_HTTPS=http://192.168.255.253:7890
PROXY_ALL=socks5://192.168.255.253:7890
PROXY_NO=localhost,127.0.0.1,192.168.255.0/24
